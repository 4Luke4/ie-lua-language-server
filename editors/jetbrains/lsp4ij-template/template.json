{
  "id": "ie-lua-language-server",
  "name": "IE Lua Language Server",
  "url": "https://github.com/4Luke4/ie-lua-language-server",
  "programArgs": {
    "windows": "node \"C:/absolute/path/to/ie-lua-language-server/dist/server/server.js\" --stdio",
    "default": "node /absolute/path/to/ie-lua-language-server/dist/server/server.js --stdio"
  },
  "expandConfiguration": true,
  "fileTypeMappings": [
    {
      "fileType": {
        "name": "Lua",
        "patterns": ["*.lua"]
      },
      "languageId": "ie-lua"
    },
    {
      "fileType": {
        "name": "IE Menu",
        "patterns": ["*.menu"]
      },
      "languageId": "ie-menu"
    }
  ]
}
